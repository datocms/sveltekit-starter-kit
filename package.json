{
  "name": "sveltekit-starter-kit",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "generate-schema": "dotenv -c -- bash -c 'gql.tada generate schema https://graphql.datocms.com --header \"X-Exclude-Invalid: true\" --header \"Authorization: $PRIVATE_DATOCMS_PUBLISHED_CONTENT_CDA_TOKEN\" && gql.tada generate-output'",
    "generate-cma-types": "dotenv -c -- bash -c 'npx datocms schema:generate src/lib/datocms/cma-types.ts --api-token=$PRIVATE_DATOCMS_CMA_TOKEN'",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "npx simple-git-hooks && npm run generate-schema && npm run generate-cma-types"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "datocms": "^4.2.0",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "simple-git-hooks": "^2.14.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "type": "module",
  "dependencies": {
    "@datocms/cda-client": "^0.3.2",
    "@datocms/cma-client": "^6.8.0",
    "@datocms/svelte": "^4.2.16",
    "@mux/mux-player": "^3.14.0",
    "datocms-structured-text-to-plain-text": "^6.0.0",
    "datocms-structured-text-utils": "^6.0.1",
    "gql.tada": "^1.11.4",
    "highlight.js": "^11.12.0",
    "jsonwebtoken": "^9.0.3",
    "node-html-parser": "^9.0.4"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run format"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "^0.7.2"
    },
    "tty-table": {
      "csv": "^6.6.4"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "simple-git-hooks@2.14.0": true,
    "yarn@1.22.22": true
  }
}
